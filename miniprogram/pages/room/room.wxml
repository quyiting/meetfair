<view wx:if="{{loadError}}" class="page-shell">
  <view class="empty-card card">
    <view class="empty-title">无法打开聚会</view>
    <view class="empty-copy">{{loadError}}</view>
    <button class="empty-action" bindtap="retryLoadRoom">重新读取</button>
  </view>
</view>
<view wx:if="{{room}}" class="room-page">
  <view class="room-hero">
    <view class="page-shell room-hero-inner">
      <view class="room-topline"><view><view class="eyebrow room-eyebrow">{{room.categoryLabel}} · {{room.transportLabel}}</view><view class="room-name">{{room.title}}</view></view><view class="room-code-wrap" bindtap="copyRoomCode">
  <view class="code-icon">#</view>
  <view class="code-center">
    <view class="code-label">{{codeLabel}}</view>
    <view class="code-preview">{{codePreview || '点击复制'}}</view>
  </view>
  <view class="code-copy-btn">复制</view>
</view></view>
      <view class="room-time">{{room.dateText}} · {{room.preview ? room.memberCount : room.members.length}} 人参与</view>
      <block wx:if="{{!room.preview}}">
        <view class="avatar-strip"><view wx:for="{{room.members}}" wx:key="id" class="member-avatar" style="background: {{item.color}}">{{item.shortName}}</view><view wx:if="{{!isMember && !room.endedAt}}" class="add-avatar join-avatar" bindtap="openJoinModal">＋</view></view>
        <view wx:if="{{!isMember && !room.endedAt}}" class="join-hint">你还没提交出发位置，可点击 ＋ 填写</view>
        <view wx:else class="joined-hint">位置已收集</view>
      </block>
    </view>
  </view>

  <view class="page-shell result-shell">
    <view wx:if="{{room.endedAt}}" class="card final-venue-card"><view class="section-title">本次聚会已结束</view><view class="section-subtitle">仅可查看。结束不会立即删除位置，数据仍按原期限保留；可主动退出或删除。</view></view>
    <view wx:if="{{!room.preview}}" class="final-venue-actions">
      <button wx:if="{{room.currentUserIsOwner && !room.endedAt}}" disabled="{{endingRoom}}" bindtap="endCurrentRoom">结束聚会</button>
      <button wx:if="{{room.currentUserIsOwner || isMember}}" bindtap="repeatRoom">再约一次</button>
    </view>
    <view wx:if="{{collectionProgress && !room.preview && !room.endedAt}}" class="card collection-progress-card">
      <view class="section-title">大家的填写进度</view>
      <view wx:if="{{collectionProgress.expectedCount}}" class="progress-expected">预计 {{collectionProgress.expectedCount}} 人（含自己，仅作参考）</view>
      <view class="progress-summary">
        <view><text class="progress-number">{{collectionProgress.locationCount}}</text> 人已提交位置</view>
        <view><text class="progress-number">{{collectionProgress.timeCount}}</text> 人已填写时间</view>
      </view>
      <view wx:if="{{collectionProgress.remainingCount}}" class="progress-hint">距离预计人数还差 {{collectionProgress.remainingCount}} 人提交位置，可继续分享邀请。</view>
      <view wx:elif="{{collectionProgress.expectedCount}}" class="progress-hint">提交位置人数已达到预计人数，不代表所有人都已填写时间。</view>
      <view wx:if="{{collectionProgress.members.length}}" class="progress-member-list">
        <view wx:for="{{collectionProgress.members}}" wx:key="id" class="progress-member-row">
          <text class="progress-member-name">{{item.name}}</text>
          <view class="progress-member-status"><text>位置已提交</text><text class="{{item.timeSubmitted ? 'progress-time-done' : 'progress-time-pending'}}">{{item.timeSubmitted ? '时间已填写' : '时间待填写'}}</text></view>
        </view>
      </view>
      <view class="progress-hint">{{collectionProgress.locationCount < 2 ? '至少 2 人提交位置即可开始推荐，不必等到预计人数到齐。' : '推荐仅使用已提交位置的成员信息；成员变化后请更新推荐。'}}</view>
      <button wx:if="{{collectionProgress.nextAction === 'invite' && room.cloudId}}" class="progress-next-button" open-type="share">{{collectionProgress.nextLabel}}</button>
      <button wx:elif="{{collectionProgress.nextAction !== 'invite'}}" class="progress-next-button" bindtap="followProgressAction">{{collectionProgress.nextLabel}}</button>
    </view>
    <button wx:if="{{room.cloudId && !room.preview && !room.endedAt && collectionProgress.nextAction !== 'invite'}}" class="room-share-button room-share-secondary" open-type="share">分享小程序链接给朋友</button>
    <view wx:if="{{!room.cloudId && room.currentUserIsOwner}}" class="empty-card card">
      <view class="empty-title">聚会仅保存在本机</view>
      <view class="empty-copy">{{room.syncError || '云端尚未同步，朋友无法通过 6 位聚会码协作。'}}</view>
      <button class="empty-action" disabled="{{syncingRoom}}" bindtap="retryCloudSync">{{syncingRoom ? '正在同步…' : '重试云端同步'}}</button>
    </view>
    <block wx:if="{{room.preview}}">
      <view class="empty-card card">
        <view class="empty-title">加入后查看聚会详情</view>
        <view class="empty-copy">成员位置、地图和推荐地点仅向已加入的成员展示；满 2 人后开始推荐。</view>
        <button wx:if="{{!room.endedAt}}" class="empty-action" bindtap="openJoinModal">填写我的出发位置并加入</button>
      </view>
    </block>
    <block wx:else>
    <view id="final-plan-section" class="card final-venue-card">
      <view class="section-title">最终方案{{finalPlanComplete ? ' · 版本 ' + (room.planRevision || 0) : '待确定'}}</view>
      <block wx:if="{{finalPlanComplete}}">
        <view class="final-venue-name">{{room.finalVenue.name}}</view>
        <view class="section-subtitle">{{room.dateText}}–{{finalEndTime}} · {{room.durationMinutes}} 分钟</view>
        <view class="section-subtitle">{{room.finalVenue.address}}</view>
        <view class="section-subtitle">参加 {{attendanceSummary.yes}} · 待定 {{attendanceSummary.maybe}} · 不参加 {{attendanceSummary.no}} · 未答复 {{attendanceSummary.unanswered}}</view>
        <view wx:for="{{attendanceSummary.members}}" wx:key="id" class="progress-member-row"><text>{{item.name}}</text><text>{{item.label}}</text></view>
        <view wx:if="{{isMember && !attendanceSummary.myStatus}}" class="progress-hint">{{planUpdated ? '方案已更新，请重新确认是否参加。' : '请确认当前方案；时间或地点变化后需重新答复。'}}</view>
        <view wx:if="{{isMember && !room.endedAt}}" class="final-venue-actions">
          <button disabled="{{attendanceSaving}}" bindtap="submitAttendance" data-status="yes">{{attendanceSummary.myStatus === 'yes' ? '✓ ' : ''}}参加</button>
          <button disabled="{{attendanceSaving}}" bindtap="submitAttendance" data-status="maybe">{{attendanceSummary.myStatus === 'maybe' ? '✓ ' : ''}}待定</button>
          <button disabled="{{attendanceSaving}}" bindtap="submitAttendance" data-status="no">{{attendanceSummary.myStatus === 'no' ? '✓ ' : ''}}不参加</button>
        </view>
      </block>
      <view wx:else class="section-subtitle">创建者确定时间与地点后，大家可在这里确认是否参加。</view>
      <view wx:if="{{!finalPlanComplete && room.finalVenue}}" class="section-subtitle">地点已确定：{{room.finalVenue.name}} · {{room.finalVenue.address}}</view>
      <view wx:if="{{room.finalVenue}}" class="final-venue-actions">
        <button bindtap="copyFinalAddress">复制地址</button>
        <button bindtap="navigateFinalVenue">导航</button>
        <button open-type="share">分享给朋友</button>
      </view>
    </view>
    <block wx:if="{{waitingForMembers}}">
      <view class="card final-venue-card">
        <view class="section-title">成员提名地点</view>
        <view wx:for="{{nominatedVenues}}" wx:key="id" class="progress-member-row"><text>{{item.name}}</text><button wx:if="{{item.canRemove && !room.endedAt}}" size="mini" data-id="{{item.id}}" disabled="{{nominationSaving}}" bindtap="removeNominatedVenue">删除</button></view>
        <view class="section-subtitle">等待至少 2 人加入后比较通勤；手动提名不提供价格和评分。</view>
        <button wx:if="{{isMember && !room.endedAt}}" class="time-edit-button" bindtap="chooseNominationLocation">＋ 提名一个地点</button>
      </view>
      <view class="empty-card card waiting-card">
        <view class="waiting-progress">{{room.members.length}} / 至少 2 人</view>
        <view class="empty-title">等待大家提交出发位置</view>
        <view class="empty-copy">把上方链接发给朋友，每个人打开后自己填写位置。满 2 人会自动尝试推荐。</view>
        <button wx:if="{{isMember && !room.endedAt}}" class="time-edit-button" bindtap="openEditMember">修改我的位置</button>
        <button wx:if="{{isMember && !room.endedAt}}" class="time-edit-button" bindtap="openAvailabilityModal">填写或修改我的可用时间</button>
      </view>
      <button wx:if="{{room.currentUserIsOwner}}" class="delete-room-button" bindtap="deleteCurrentRoom">删除本次聚会及位置数据</button>
      <button wx:if="{{isMember && !room.currentUserIsOwner}}" class="delete-room-button" bindtap="leaveCurrentRoom">退出聚会并删除我的位置</button>
    </block>
    <block wx:else>
    <view wx:if="{{room.meetingDate}}" class="card time-suggestion-card">
      <view class="section-title">聚会时间建议 · {{room.durationMinutes}} 分钟</view>
      <view wx:for="{{dateResponses}}" wx:key="date" class="section-subtitle">{{item.date}}：{{item.responded}} / {{room.members.length}} 人已答复</view>
      <view class="section-subtitle">{{timeResponded}} / {{room.members.length}} 人已填写可用时间{{room.finalTimeAt ? ' · 创建者已确定 ' + room.meetingTime : ''}}</view>
      <view wx:for="{{timeSuggestions}}" wx:key="index" class="time-suggestion-row">
        <view><text class="time-suggestion-value">{{item.date}} {{item.start}}–{{item.end}}</text><view class="section-subtitle">{{item.count}} / {{item.responded}} 位已答复成员可参加（共 {{item.total}} 人）</view></view>
        <button wx:if="{{room.currentUserIsOwner && !room.endedAt}}" class="time-confirm-button" bindtap="confirmSuggestedTime" data-time="{{item.start}}" data-date="{{item.date}}">确定</button>
      </view>
      <view wx:if="{{!timeSuggestions.length}}" class="section-subtitle">暂无能覆盖完整聚会时长的时段；可补充时间或与朋友协商。当天会预留通勤缓冲。</view>
      <button wx:if="{{isMember && !room.endedAt}}" class="time-edit-button" bindtap="openAvailabilityModal">填写或修改我的可用时间</button>
    </view>
    <view class="fairness-card card">
      <view class="fairness-icon">⌘</view>
      <view class="fairness-text"><view class="fairness-title">选择这次聚会的推荐目标</view><view class="fairness-copy">{{goalDescription}}。下拉页面可同步朋友的加入和投票。</view></view>
    </view>
    <view wx:if="{{room.candidateDates.length > 1 && !room.finalTimeAt}}" class="recommendation-reason">日期尚未最终确定，地图、营业状态与路线暂按 {{room.meetingDate}} {{room.meetingTime}} 计算。</view>
    <view wx:if="{{recommendationsStale}}" class="empty-card card">
      <view class="empty-title">{{room.schemaVersion === 2 && !room.venues.length ? '等待生成首次推荐' : '成员信息已变化，推荐待更新'}}</view>
      <view class="empty-copy">{{room.schemaVersion === 2 && !room.venues.length ? '已有 2 人提交位置，点击生成地点建议；搜索失败也不会影响已加入成员。' : '当前地点和路线基于旧成员信息，更新后再比较通勤时间。'}}</view>
      <button wx:if="{{!room.endedAt && (!room.cloudId || room.currentUserIsOwner || (room.schemaVersion === 2 && isMember))}}" class="empty-action" disabled="{{refreshingNearby}}" bindtap="refreshNearby">{{refreshingNearby ? '正在更新…' : (room.schemaVersion === 2 && !room.venues.length ? '生成推荐' : '更新推荐')}}</button>
      <view wx:else class="empty-copy">等待有权限的成员更新推荐后会自动同步。</view>
    </view>

    <map class="meeting-map" latitude="{{point.latitude}}" longitude="{{point.longitude}}" scale="13" markers="{{markers}}" show-location="false"></map>
    <view class="map-caption"><text>●</text> 橙色为朋友出发点，蓝色为当前推荐地点</view>

    <view class="category-tabs"><view wx:for="{{categories}}" wx:key="id" class="category-tab {{activeCategory === item.id ? 'tab-active' : ''}}" bindtap="selectCategory" data-id="{{item.id}}">{{item.label}}</view></view>
    <view class="goal-tabs"><view wx:for="{{goals}}" wx:key="id" class="category-tab {{activeGoal === item.id ? 'tab-active' : ''}}" bindtap="selectGoal" data-id="{{item.id}}">{{item.label}}</view></view>
    <view id="recommendations-section" class="list-heading"><view><view class="section-title">推荐地点</view><view class="section-subtitle">{{room.venueSourceLabel}}</view></view><button wx:if="{{!room.endedAt && (!room.cloudId || room.currentUserIsOwner || (room.schemaVersion === 2 && isMember))}}" class="search-nearby" disabled="{{refreshingNearby}}" bindtap="refreshNearby">{{room.schemaVersion === 2 && !room.venues.length ? '生成推荐' : '更新附近'}}</button></view>
    <view wx:if="{{topRecommendationReason}}" class="recommendation-reason">{{topRecommendationReason}}</view>
    <button wx:if="{{isMember && !room.endedAt}}" class="time-edit-button" bindtap="chooseNominationLocation">＋ 提名一个地点（{{nominatedVenues.length}} / 8）</button>

    <view wx:if="{{recommendations.length}}" class="venue-list">
      <view wx:for="{{recommendations}}" wx:key="id" class="venue-card card {{selectedVenueId === item.id ? 'venue-selected' : ''}}" bindtap="selectVenue" data-id="{{item.id}}">
        <view class="venue-rank">{{index + 1}}</view>
        <view class="venue-main" bindtap="openPlace" data-id="{{item.id}}">
          <view class="venue-title-row"><view class="venue-name">{{item.name}}</view><view class="fairness-tag">{{item.fairness}}</view></view>
          <view class="venue-info">{{item.metaText}}</view>
          <view wx:if="{{item.source === 'manual'}}" class="section-subtitle">成员提名 · 价格和评分未知</view>
          <view class="venue-note">{{item.highlight}}</view>
          <view wx:if="{{item.preferenceMatchText}}" class="preference-match">{{item.preferenceMatchText}}</view>
          <view wx:if="{{item.budgetStatus}}" class="budget-fit">{{item.budgetStatus}}</view>
          <view class="travel-summary">最远 <text>{{item.maxMinutes}} 分钟</text>　平均 {{item.averageMinutes}} 分钟 · 差距 {{item.spreadMinutes}} 分钟 · 真实路线 {{item.routeCoverage}}/{{room.members.length}} 人</view>
        </view>
        <button wx:if="{{!room.endedAt}}" class="vote-button {{item.hasVoted ? 'voted' : ''}}" catchtap="toggleVote" data-id="{{item.id}}">♥ {{item.voteCount}}</button>
      </view>
    </view>
    <view wx:else class="empty-card card">
      <view class="empty-icon">⌕</view>
      <view class="empty-title">这里暂时没有匹配地点</view>
      <view class="empty-copy">试试切换活动类型，或重新搜索折中区域附近的地点。</view>
      <button wx:if="{{!room.endedAt && (!room.cloudId || room.currentUserIsOwner || (room.schemaVersion === 2 && isMember))}}" class="empty-action" disabled="{{refreshingNearby}}" bindtap="refreshNearby">重新搜索附近</button>
    </view>
    <button wx:if="{{room.currentUserIsOwner && selectedVenueId && !room.endedAt}}" class="confirm-venue-button" bindtap="confirmSelectedVenue">{{room.finalVenue ? '重新确定选中的地点' : '确定选中的地点'}}</button>
    <view wx:for="{{nominatedVenues}}" wx:key="id" class="progress-member-row"><text>提名：{{item.name}}</text><button wx:if="{{item.canRemove && !room.endedAt}}" size="mini" data-id="{{item.id}}" disabled="{{nominationSaving}}" bindtap="removeNominatedVenue">删除</button></view>
    <view wx:if="{{claimableMembers.length && !room.endedAt}}" class="claim-card card">
      <view class="section-title">邀请预填成员认领</view>
      <view class="section-subtitle">为每个人生成一次性认领码，私下发送给本人。</view>
      <button wx:for="{{claimableMembers}}" wx:key="id" class="claim-button" bindtap="issueClaimCode" data-id="{{item.id}}">生成 {{item.name}} 的认领码</button>
    </view>
    <button wx:if="{{isMember && !room.endedAt}}" class="edit-member-button" bindtap="openEditMember">编辑我的位置与出行信息</button>
    <button wx:if="{{room.currentUserIsOwner}}" class="delete-room-button" bindtap="deleteCurrentRoom">删除本次聚会及位置数据</button>
    <button wx:if="{{isMember && !room.currentUserIsOwner}}" class="delete-room-button" bindtap="leaveCurrentRoom">退出聚会并删除我的位置</button>
    </block>
    </block>
  </view>

  <view wx:if="{{nominationDraft}}" class="modal-mask" bindtap="closeNomination">
    <view class="modal-dialog" catchtap="noop">
      <view class="modal-header"><view class="modal-title">确认提名地点</view><view class="modal-close" bindtap="closeNomination">×</view></view>
      <view class="modal-body">
        <input class="form-input" maxlength="80" value="{{nominationDraft.name}}" bindinput="setNominationName" placeholder="地点名称"/>
        <view class="form-hint">{{nominationDraft.address}}</view>
        <picker range="{{nominationCategories}}" range-key="label" value="{{nominationCategoryIndex}}" bindchange="selectNominationCategory"><view class="meeting-time-picker">{{nominationCategories[nominationCategoryIndex].label}}</view></picker>
        <view class="form-hint">仅提名公共地点，请勿填写住宅等私人地址。无地图路线时使用估算。</view>
      </view>
      <view class="modal-footer"><button class="modal-submit" disabled="{{nominationSaving}}" bindtap="submitNomination">{{nominationSaving ? '正在保存…' : '保存提名'}}</button></view>
    </view>
  </view>
  <view wx:if="{{showJoinModal}}" class="modal-mask" bindtap="closeJoinModal">
    <view class="modal-dialog" catchtap="noop">
      <view class="modal-header">
        <view class="modal-title">{{editingMember ? '编辑我的信息' : '加入聚会'}}</view>
        <view class="modal-close" bindtap="closeJoinModal">×</view>
      </view>
      <view class="modal-body">
        <view class="form-group">
          <view class="form-label">你的名字</view>
          <input class="form-input" placeholder="输入名字，最多8个字" value="{{joinName}}" bindinput="setJoinName" />
          <view wx:if="{{!editingMember && room.schemaVersion !== 2}}" class="form-hint">创建者预填了你的信息时，请向创建者索取认领码。</view>
        </view>
        <view wx:if="{{!editingMember && room.schemaVersion !== 2}}" class="form-group">
          <view class="form-label">认领码（选填）</view>
          <input class="form-input" placeholder="认领预填成员时填写 16 位码" maxlength="16" value="{{joinClaimCode}}" bindinput="setJoinClaimCode" />
        </view>
        <view class="form-group">
          <view class="form-label">出发位置</view>
          <view class="location-picker">
            <view class="location-value">{{joinLocationName || '请选择位置'}}</view>
            <view class="location-actions">
              <button class="action-btn" bindtap="locateJoinMe">📍 获取定位</button>
              <button class="action-btn" bindtap="chooseJoinLocation">🗺️ 地图选点</button>
            </view>
          </view>
          <view class="privacy-option"><text>只共享约 1 公里精度的位置</text><switch checked="{{joinApproximate}}" bindchange="toggleJoinApproximate" color="#1f5eff" /></view>
        </view>
        <view class="form-group">
          <view class="form-label">出行方式</view>
          <view class="option-group">
            <view class="option-item {{joinTransport === 'walking' ? 'option-active' : ''}}" bindtap="selectJoinTransport" data-transport="walking">🚶 步行</view>
            <view class="option-item {{joinTransport === 'bicycle' ? 'option-active' : ''}}" bindtap="selectJoinTransport" data-transport="bicycle">🚲 骑行</view>
            <view class="option-item {{joinTransport === 'transit' ? 'option-active' : ''}}" bindtap="selectJoinTransport" data-transport="transit">🚇 地铁</view>
            <view class="option-item {{joinTransport === 'driving' ? 'option-active' : ''}}" bindtap="selectJoinTransport" data-transport="driving">🚗 自驾</view>
          </view>
        </view>
        <view class="form-group">
          <view class="form-label">预算</view>
          <view class="option-group">
            <view wx:for="{{budgets}}" wx:key="value" class="option-item {{joinBudget === item.value ? 'option-active' : ''}}" bindtap="selectJoinBudget" data-budget="{{item.value}}">{{item.label}}</view>
          </view>
        </view>
      </view>
      <view class="modal-footer">
        <button class="modal-submit" disabled="{{joinSubmitting}}" bindtap="submitJoin">{{joinSubmitting ? '正在保存…' : (editingMember ? '保存修改' : '确认加入')}}</button>
      </view>
    </view>
  </view>
  <view wx:if="{{showAvailabilityModal}}" class="modal-mask" bindtap="closeAvailabilityModal">
    <view class="modal-dialog" catchtap="noop">
      <view class="modal-header"><view class="modal-title">我的可用时间</view><view class="modal-close" bindtap="closeAvailabilityModal">×</view></view>
      <view class="modal-body">
        <picker range="{{availabilityDates}}" value="{{availabilityDateIndex}}" disabled="{{availabilitySaving}}" bindchange="selectAvailabilityDate"><view class="meeting-time-picker">{{availabilityDate}} ▾</view></picker>
        <view class="form-hint">每一天分别保存，最多 5 段；聚会时长 {{room.durationMinutes}} 分钟。切换日期会放弃未保存草稿。</view>
        <view wx:for="{{availabilityDraft}}" wx:key="start" class="availability-row">
          <text>{{item.start}}–{{item.end}}</text><button bindtap="removeAvailabilityRange" data-index="{{index}}">移除</button>
        </view>
        <view class="availability-pickers">
          <picker mode="time" value="{{availabilityStart}}" bindchange="setAvailabilityStart"><view class="meeting-time-picker">开始 {{availabilityStart}}</view></picker>
          <picker mode="time" value="{{availabilityEnd}}" bindchange="setAvailabilityEnd"><view class="meeting-time-picker">结束 {{availabilityEnd}}</view></picker>
        </view>
        <button class="time-edit-button" bindtap="addAvailabilityRange">添加时段</button>
        <button class="time-edit-button" disabled="{{availabilitySaving}}" bindtap="markUnavailable">这天没空（保存）</button>
      </view>
      <view class="modal-footer"><button class="modal-submit" disabled="{{availabilitySaving}}" bindtap="saveAvailability">{{availabilitySaving ? '正在保存…' : '保存可用时间'}}</button></view>
    </view>
  </view>
</view>
